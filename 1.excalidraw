      "text": "trajectory_reward → (GRPO group) → trajectory_advantage →(÷turns) → turn credit → (÷steps) → step credit → (÷rollout tokens) → token credit",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "trajectory_reward → (GRPO group) → trajectory_advantage →(÷turns) → turn credit → (÷steps) → step credit → (÷rollout tokens) → token credit",
      "autoResize": true,
      "lineHeight": 1.25
    },
