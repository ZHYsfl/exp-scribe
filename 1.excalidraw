    },
    {
      "id": "D3qxNFpAzdkitQIlXH_MR",
      "type": "text",
      "x": 2846.89316129402,
      "y": -519.5145527182966,
      "width": 998.9198608398438,
      "height": 75,
      "angle": 0.00526537817678463,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 1657557870,
      "version": 1601,
      "versionNonce": 621576562,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783702831464,
      "link": null,
      "locked": false,
      "text": "training free的话，每次试错的经验是一次性的，否则设计记忆架构，token效率必定增加。\nreact决定了即使training,状态和状态转换是隐式的，对状态转换的后果没有前瞻性和规划，短视,所以要不断试错.\n训练效率低，准确率和token效率提高还不够多。且刚才的方法并没有精细的信用分配。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "training free的话，每次试错的经验是一次性的，否则设计记忆架构，token效率必定增加。\nreact决定了即使training,状态和状态转换是隐式的，对状态转换的后果没有前瞻性和规划，短视,所以要不断试错.\n训练效率低，准确率和token效率提高还不够多。且刚才的方法并没有精细的信用分配。",
      "autoResize": true,
      "lineHeight": 1.25
    },
